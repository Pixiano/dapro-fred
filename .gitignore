# Secrets - never commit
*.env
.env
KEYS!.txt
# Per-device shared secrets for Core/web/phone_api.py's LAN endpoint.
Core/data/phone_tokens.json

# Haier AC local keys (see Core/tools/haismart_setup.py / haismart_tools.py)
# — device_id + localKey together are full control authority over the
# appliance from anywhere on the LAN. Fetched once from the Haier account,
# never something to commit.
Core/data/haismart_devices.json

# HTTP Shortcuts import JSON (Core/tools/http_shortcuts_setup.py) carries
# a real phone_tokens.json token inline — same sensitivity, same
# handling. Confirmed 2026-08-20: this was NOT actually covered by any
# existing rule despite the file's own generating script claiming it
# was gitignored — real gap, fixed here.
Core/data/http_shortcuts_export.json

# Call-log proactive-check watermark (phone_tools.CALL_SEEN_PATH) — low
# sensitivity but still per-run generated state, not source.
Core/data/call_log_seen.json

# Transient camera capture (tools/phone_tools.capture_camera_photo) —
# overwritten every call, never source.
Core/data/camera_capture.png

# Face embeddings + reference photo (Core/scripts/enroll_face.py) and
# presence poll state (Core/input/presence.py) — biometric/personal data,
# same treatment as personal/ vault content. Never something to commit.
Core/data/face_enrollment.json
Core/data/face_reference.jpg
Core/data/presence_state.json

# Python
__pycache__/
*.pyc
venv/

# Node
node_modules/

# Memory data (personal, runtime-generated, or old conversation logs
# naming real people - same rationale across Core/ and Legacy/)
#
# Current location, from settings.MEMORY_DIR / INDEX_DIR:
Core/data/memory/
Core/data/indexes/
# Pre-2026-07-29 stores, kept for reference. memory_manager.py used to
# build these paths relative to the CWD, so FRED accumulated two separate
# memories depending on whether it was launched from Core/ or the repo
# root, and neither could see the other.
Core/data/memory_archive/
# The old CWD-relative locations themselves. Retained so that anything
# still writing there stays ignored rather than silently committed.
Core/memory_data/
Core/memory_indexes/
/memory_data/
/memory_indexes/

# Abandoned PyInstaller EXE build (DLL bundling issues with
# llama-cpp-python - see commit history). Launchers are plain
# batch files now.
/build/
/dist/
Legacy/FRED/Main/API/Memories/
Legacy/FRED/Main/API/User_Memories/
Legacy/FRED/Main/API/Faiss_Index/

# Logs (includes per-session event logs — full speech transcripts,
# errors, tool calls; see Core/utils/event_log.py)
Core/data/logs/

# Scheduled reminders (personal, runtime-generated)
Core/data/reminders.sqlite

# Tool-call routing log (personal usage data — utterances, arguments,
# results). See Core/orchestrator/tool_call_log.py.
Core/data/tool_call_log.jsonl

# Wake-word detection log (runtime data — see Core/input/wakeword_log.py)
Core/data/wakeword_log.jsonl

# Presence poll history (personal activity data, same treatment as the
# rest of presence.py's state — see Core/input/presence_log.py)
Core/data/presence_log.jsonl

# Overlay window position/palette (runtime-mutable user state, written
# by the tray settings UI - regenerates from defaults if missing)
Core/config/overlay_settings.json

# Kokoro TTS model + voicepacks (~310MB + 27MB), past GitHub's 100MB
# per-file limit. Release downloads, not pip data - see the URL in
# Core/config/settings.py to re-fetch.
Core/models/kokoro/

# Wake-word training workspace (piper-sample-generator clone, DEMAND
# noise zips, synthetic clips, feature caches) and the trained model
# output - all regeneratable via Core/input/wakeword_train.py, not
# source. See that script's docstring to retrain.
Core/data/wakeword_training/
Core/models/wakeword/

# faster-whisper models live in the HuggingFace cache, not the repo,
# and are fetched on first run.

# Audio runtime artifacts
fred_tts_output.mp3

# Raw footage/audio (~40GB+, individual files past GitHub's 100MB
# limit) - track separately or with Git LFS if ever needed
Video/

# Old large model/binary files past GitHub's 100MB hard limit -
# superseded by Core/'s own smaller Vosk model anyway
Legacy/FRED/Main/API/Models/vosk-model-en-in-0.5/
Legacy/FRED/Main/API/Shortcuts/Godot.exe
Legacy/FRED/Others/OS_Automation_Perfection/Shortcuts/Godot.exe

# Core's own copy of the same model (now the active STT_MODEL_PATH) -
# contains rescore/G.carpa (880MB) and graph/HCLG.fst (446MB), both
# past GitHub's 100MB per-file hard limit. Local-only asset.
Core/models/vosk-model-en-in-0.5/

# Screenshots and other tool output that can contain personal screen
# content. take_screenshot used to default to a working-directory-relative
# path, which for a detached app meant the repo root — one was committed
# and pushed before that was fixed (see Pictures/Screenshots now).
screenshot_*.png
*.screenshot.png
Core/data/memory_archive/

# Vault knowledge router cache — contains raw text chunks from the vault,
# including personal/ and people/ content. Must never be committed.
Core/data/vault_index/

# Resolved-path cache for search_files/find_file_smart (see
# Core/tools/found_cache.py). Real filesystem paths from his machine —
# personal, and runtime-regenerated on demand anyway.
Core/data/found_files.json

# Proactive-check dedup state (see Core/orchestrator/proactive_checks.py).
# Records when he was last active at the keyboard — runtime state, and
# personal activity data.
Core/data/proactive_state.json

# Cross-process model-residency status (see Core/config/settings.py's
# SCREEN WATCHER section) — pure runtime state, regenerates on launch.
Core/data/llm_status.json

# Lockdown mode: persisted lock/unlock flag and event log (see
# Core/state/lockdown_state.py, Core/state/lockdown_log.py) — runtime
# state. The PIN itself is a plain constant in system_tools.py, not a
# file — nothing to gitignore for it.
Core/data/lockdown_state.json
Core/data/lockdown_log.jsonl

# Remembered mic/speaker choice, by name (see Core/audio/device_info.py)
# — which physical devices are plugged into this machine, runtime state.
Core/data/audio_device_prefs.json

# Which WhatsApp messages the VIP watcher has already announced (see
# Core/tools/whatsapp_tools.py). Timestamps and sender names — a record of
# who messaged him and when, so it stays out of the repo. The tiers
# themselves live in the vault, not here.
Core/data/whatsapp_seen.json

# Screen-watcher's cached description of the screen. Never the
# screenshot image itself (that never touches disk at all — see
# Core/vision/screen_watcher.py) but the text description is still a
# record of what was on his screen, so it stays out of the repo.
Core/data/screen_context.json

# Pre-synthesised filler/tool-caption audio cache — regenerates on
# first launch after a clean clone, nothing authored lives here.
Core/data/phrase_cache/

# Dev-session working notes (not meant for the public repo)
session_2026-08-12_wakeword_changes.md

# Maintained filesystem index for Core/tools/file_index.py's search_index
# — real file paths off this machine's home folder, and fully
# regeneratable via reindex_drive(). Same rationale as found_files.json.
Core/data/file_index.db

# Screenshots from setting up the HTTP Shortcuts phone integration
# (Core/tools/http_shortcuts_setup.py) — real phone-screen content, same
# treatment as the screenshot_*.png rule above.
Core/data/http_shortcuts_*.png

# Raw wake-word voice recordings (Core/training/Recordings/) — personal
# voice data staged for a future training pass, not source. Same
# rationale/precedent as Core/data/wakeword_training/ below.
Core/training/


# Wispr Flow demo-video raw footage - past GitHub's 100MB
# per-file hard limit (1.6GB / 838MB). Source footage, kept locally.
Wispr/fred_vid.mp4
Wispr/IMG_2698.MOV
